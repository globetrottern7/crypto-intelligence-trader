# Copy to .env only in a trusted cloud environment. Never commit real secrets.
APP_ENV=production
POSTGRES_DB=crypto_intelligence
POSTGRES_USER=crypto_app
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql+psycopg://crypto_app:replace_with_url_encoded_password@db:5432/crypto_intelligence
BACKEND_CORS_ORIGINS=https://your-frontend-domain.example
API_ACCESS_TOKEN=replace_with_a_long_random_token
DASHBOARD_PASSWORD=replace_with_a_strong_unique_password
SESSION_SECRET=replace_with_at_least_32_random_bytes
PAPER_INITIAL_CAPITAL=5000
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=10
BACKEND_IMAGE=ghcr.io/globetrottern7/crypto-intelligence-backend:latest
FRONTEND_IMAGE=ghcr.io/globetrottern7/crypto-intelligence-frontend:latest
MARKET_DATA_SYMBOLS=BTC/INR
COINSWITCH_API_KEY=
COINSWITCH_SECRET_KEY=
